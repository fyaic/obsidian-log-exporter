# LLM API 配置（支持 OpenAI 兼容接口，留空则使用 heuristic fallback）
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Obsidian Vault 路径
VAULT_PATH=C:\Users\ryshi\Documents\AIC-000

# 报告输出目录
REPORTS_DIR=./reports

# 可选：将报告同时写回 Obsidian vault 的相对路径
# VAULT_REPORT_PATH=T-B AI工作搭子/日报

# 可选：Obsidian Sync 用户名标准化映射（JSON 字符串）
# 把 Sync 原始用户名映射成你想要的显示名
# NAME_ALIAS={"Rosetta Guo":"Rosetta","veilchow":"Veil"}

# 可选：Obsidian Sync 设备名到贡献者的映射（JSON 字符串）
# 当 Sync username 为空时，用 device 名 fallback
# DEVICE_MAP={"Rosetta":"Rosetta","fuyo-aicdeMac-mini.local":"Veil"}
